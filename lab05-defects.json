  "item": [
    {
      "name": "D01 — СОГОГ: studentID='toString' (байхгүй оюутан) → ERROR_NO_STUDENT байх ёстой",
      "item": [
        {
          "name": "setup: хичээл CS101-D01",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/CS101-D01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "CS101-D01"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\": []}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"setup: 200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST: studentID toString → ERROR_NO_STUDENT хүлээнэ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\": \"toString\", \"courseID\": \"CS101-D01\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"result = ERROR_NO_STUDENT\", () => pm.expect(pm.response.json().result).to.eql(\"ERROR_NO_STUDENT\"));"
                ]
              }
            }
          ]
        }
      ]
    },
